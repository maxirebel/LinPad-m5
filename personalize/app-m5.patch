diff --git a/app/AppDelegate.m b/app/AppDelegate.m
index 0edc1e9..e56fe2c 100644
--- a/app/AppDelegate.m
+++ b/app/AppDelegate.m
@@ -259,6 +259,22 @@ static void ApplyMemorySettings(void) {
         setenv("ISH_OOM_PROTECT", protect.UTF8String, 1);
 }
 
+// Guest memory that jetsam does not charge to the app: anonymous mappings placed in an
+// unlinked sparse file on the app's container (kernel/swapfile.h) are "external" pages,
+// so iPadOS can write them back and drop them. LinPad ships with this off; a device with
+// 6 GB or more can afford the file, and under pressure it turns "close Firefox" into a
+// short stall. ISH_SWAPFILE=pressure maps only while the out-of-memory monitor is below
+// its soft limit. Set LINPAD_NO_SWAPFILE=1 (or delete this function's call) to disable.
+static void ApplySwapFile(void) {
+    if (getenv("LINPAD_NO_SWAPFILE") != NULL)
+        return;
+    uint64_t ram = 0;
+    size_t size = sizeof(ram);
+    if (sysctlbyname("hw.memsize", &ram, &size, NULL, 0) != 0 || ram < (6ull << 30))
+        return;
+    setenv("ISH_SWAPFILE", "pressure", 1);
+}
+
 // Called on the monitor's thread after it closed a guest process; the desktop shows
 // the message (DesktopController observes the notification).
 static void ios_handle_oom_kill(const char *app, const char *message) {
@@ -1020,6 +1036,7 @@ static void (^backgroundURLSessionCompletion)(void);
 #if !ISH_LINUX
     ApplyJITSettings();
     ApplyMemorySettings();
+    ApplySwapFile();
     [self startBoot];
 #else
     bootError = [self boot];
